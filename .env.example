# =============================================================================
# Email Outreach Platform — environment template.
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# App connection (pooled, e.g. pgbouncer / Neon pooler).
#
# IMPORTANT for managed Postgres (Neon, Supabase, ...): the instance auto-suspends
# after a few minutes of inactivity and the cold start can exceed Prisma's
# default 5 s connect timeout. Add `connect_timeout=30` (and `pool_timeout=30`).
# The app injects these automatically if they are missing, but it is clearer to
# set them explicitly.
#
#   Neon pooled :  ?sslmode=require&connect_timeout=30&pgbouncer=true&connection_limit=5
#   Neon direct :  ?sslmode=require&connect_timeout=30
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outreach?schema=public"
# Optional dedicated connection for migrations (unpooled).
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/outreach?schema=public"
# Optional: a SEPARATE database for the integration test suite. The tests
# TRUNCATE every table, so never point this at the application database.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outreach_test?schema=public"

# --- Application -------------------------------------------------------------
# Public URL of the app (used for OAuth redirects, unsubscribe links, CSRF origin checks).
APP_URL="http://localhost:3000"
# Node environment: development | production | test
NODE_ENV="development"

# --- Security ----------------------------------------------------------------
# JWT signing secret for session cookies. Generate: openssl rand -base64 64
AUTH_SECRET="replace-with-64-byte-base64-string"
# AES-256-GCM key for encrypting provider tokens at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-32-byte-base64-string"
# Session lifetime in seconds (default 7 days).
SESSION_TTL_SECONDS="604800"
# Comma-separated extra origins allowed to call the API (CORS/CSRF allow-list).
# EXTRA_ALLOWED_ORIGINS="https://app.example.com"

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED="true"
# Requests per window for login/register endpoints.
RATE_LIMIT_AUTH_MAX="10"
RATE_LIMIT_AUTH_WINDOW_SECONDS="60"
# Requests per window for general API endpoints.
RATE_LIMIT_API_MAX="120"
RATE_LIMIT_API_WINDOW_SECONDS="60"

# --- Google OAuth (Gmail API) ------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match an Authorized redirect URI in the Google Cloud console.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
# Scopes requested for Gmail sender accounts (least privilege for sending).
GOOGLE_SCOPES="https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile"

# --- SMTP fallback -----------------------------------------------------------
# Optional shared SMTP relay used when an account is connected via SMTP settings.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"

# --- Sending policy ----------------------------------------------------------
# Hard application cap per sender account per day. Must NEVER exceed provider limits.
SENDER_DAILY_CAP_DEFAULT="100"
# Time zone used for daily quota reset of sender accounts (IANA name).
SENDER_QUOTA_TIMEZONE="UTC"
# Maximum sender accounts per workspace initially.
MAX_SENDER_ACCOUNTS="10"
# Minimum days between two emails to the same contact (contact-frequency limit).
MIN_DAYS_BETWEEN_CONTACTS="3"

# --- Worker ------------------------------------------------------------------
# Poll interval in ms.
WORKER_POLL_INTERVAL_MS="2000"
# Jobs claimed per poll cycle.
WORKER_BATCH_SIZE="20"
# Lease (claim) duration in seconds; jobs whose lease expires are recovered.
WORKER_LEASE_SECONDS="120"
# Maximum delivery attempts per job (including the first).
WORKER_MAX_ATTEMPTS="5"
# Base delay (ms) for exponential backoff with jitter.
WORKER_BACKOFF_BASE_MS="5000"

# --- Observability -----------------------------------------------------------
LOG_LEVEL="info"
