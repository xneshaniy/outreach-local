# =============================================================================
# Email Outreach Platform — local/test PostgreSQL for integration tests.
# Copy to `.env.test` or export TEST_DATABASE_URL to run the integration suite.
# =============================================================================

# Dedicated test database — NEVER point this at production data.
# Integration tests TRUNCATE every table before each test.
#
# IMPORTANT: do NOT use a transaction pooler (Neon's "-pooler" host, PgBouncer)
# for the test database. The suite opens several transactions at once on
# purpose, and a pooler answers with "Unable to start a transaction in the
# given time" instead of running them. Use the direct endpoint and give
# Prisma a pool big enough for that contention (the quota test opens 8).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/outreach_test?schema=public&connection_limit=20"

# Same URL for `prisma migrate deploy` when preparing the test schema.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/outreach_test?schema=public"

NODE_ENV="test"
APP_URL="http://localhost:3000"

# Test-only secrets (obviously fake; not valid outside tests).
AUTH_SECRET="test-auth-secret-0123456789abcdefghijklmnop"
ENCRYPTION_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="

# Keep tests deterministic.
RATE_LIMIT_ENABLED="false"
LOG_LEVEL="error"
