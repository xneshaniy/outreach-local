// Email Outreach Platform — Prisma schema (PostgreSQL).
// Design notes:
//  - Duplicate prevention is DATABASE-ENFORCED:
//      * Contact:            @@unique([userId, emailNormalized])
//      * CampaignRecipient:  @@unique([campaignId, contactId])  (one contact per campaign, ever)
//      * SendJob:            @unique(campaignRecipientId) + @unique(idempotencyKey)
//      * SendAttempt:        @@unique([jobId, attemptNumber])
//  - Provider tokens are stored ENCRYPTED (AES-256-GCM) in *Enc columns; never exposed to the client.
//  - Atomic claiming uses SELECT ... FOR UPDATE SKIP LOCKED + leases (see src/lib/queue.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Uncomment for pooled setups (Neon/Supabase) that require an unpooled migration URL:
  // directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum SenderProvider {
  GOOGLE
  SMTP
}

enum SenderStatus {
  CONNECTED
  PAUSED
  DISCONNECTED
  ERROR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum RecipientStatus {
  PENDING // added, not yet scheduled
  HELD_TZ // invalid/unknown time zone, held for review
  SCHEDULED // scheduledAt computed, waiting for due time
  QUEUED // job enqueued and due-window reached
  SENDING // job claimed by a worker
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

enum JobStatus {
  QUEUED
  CLAIMED
  SENT
  FAILED
  SKIPPED
  CANCELLED
  AMBIGUOUS // provider outcome unknown (e.g. timeout after submit) — must be reconciled
}

enum AttemptStatus {
  SUCCESS
  TRANSIENT_FAILURE
  PERMANENT_FAILURE
  AMBIGUOUS
}

enum ProviderKind {
  GMAIL
  SMTP
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  INVALID
  REPLIED // the contact replied to an outreach message
  INTERESTED // the contact replied and asked for more (manually marked)
}

enum SuppressionScope {
  GLOBAL
  CAMPAIGN
}

enum SuppressionReason {
  UNSUBSCRIBE
  BOUNCE
  HARD_BOUNCE
  COMPLAINT
  MANUAL
  LIST_UNSUBSCRIBE
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TzFallbackMode {
  HOLD // hold recipients with unknown/invalid tz for review (default, safest)
  FALLBACK // schedule using fallbackTimeZone
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  INVALID_SIGNATURE
}

enum FollowUpStatus {
  SCHEDULED // waiting for its turn
  SENDING // claimed by a worker
  SENT // the provider accepted it
  FAILED // permanent failure
  CANCELLED // cancelled (replied, unsubscribed, bounced, campaign paused)
  SKIPPED // skipped (suppressed, ineligible, outside the window)
}

enum SendJobKind {
  ORIGINAL // the campaign's first message
  FOLLOW_UP // a follow-up sequence step
}

enum TrackingEventType {
  OPEN // the tracking pixel was fetched
  CLICK // a tracked link was followed
}

enum TrackingSource {
  HUMAN // a real mail client (best guess)
  PREVIEW // Apple Mail Privacy Protection / browser previews
  BOT // security scanners, link checkers, image proxies
}

// ---------------------------------------------------------------------------
// The single vocabulary used for reporting, the queue UI and the client
// portal. "ACCEPTED" means the provider took the message; "DELIVERED" only
// ever means a delivery event confirmed it. They are never conflated.
// ---------------------------------------------------------------------------
enum MessageStatus {
  DRAFT // not queued yet
  QUEUED // in the database queue
  SCHEDULED // queued for a future instant
  PROCESSING // claimed by a worker
  ACCEPTED // the provider accepted the message
  DELIVERED // a delivery event confirmed it
  BOUNCED // the address hard-bounced
  FAILED // the send failed permanently
  CANCELLED // stopped before sending
  REPLIED // the contact replied
  UNSUBSCRIBED // the contact opted out
  SKIPPED // ineligible (suppressed, held, frequency limit, ...)
}

enum NotificationType {
  REPLY // a reply arrived
  INTERESTED // a reply was classified as interested
  CAMPAIGN_COMPLETED
  CAMPAIGN_FAILED
  PROVIDER_DISCONNECTED // a sender account needs attention
  QUEUE_FAILURE // jobs failed permanently
  IMPORT_COMPLETED
  CONFIG_PROBLEM // the configuration is incomplete or wrong
  TASK_DUE // a follow-up task is due
  DEAD_LETTER // a job was moved to the dead-letter state
  SYSTEM
}

enum ContactActivityType {
  CREATED
  IMPORTED
  UPDATED
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  REPLIED
  UNSUBSCRIBED
  BOUNCED
  SUPPRESSED
  STAGE_CHANGED
  PRIORITY_CHANGED
  OWNER_CHANGED
  NOTE_ADDED
  TASK_COMPLETED
  CONVERTED
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TemplateCategory {
  OUTREACH // first contact
  FOLLOW_UP
  INTERESTED // a reply to an interested prospect
  MEETING // meeting request
  PROPOSAL // proposal follow-up
  ONBOARDING // client onboarding
  CUSTOM
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  passwordHash          String
  name                  String?
  role                  Role     @default(OWNER)
  // Bumping this invalidates every outstanding session token.
  sessionVersion        Int      @default(0)
  minDaysBetweenContacts Int     @default(3)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  senderAccounts   SenderAccount[]
  contacts         Contact[]
  campaigns        Campaign[]
  templates        EmailTemplate[]
  importBatches    ImportBatch[]
  suppressions     Suppression[]
  auditLogs        AuditLog[]
  webhookEvents    WebhookEvent[]
  unsubscribeEvents UnsubscribeEvent[]
  idempotencyKeys  IdempotencyKey[]
  services         Service[]
  followUpSequences FollowUpSequence[]
  followUpMessages  FollowUpMessage[]
  replies           Reply[]
  clients           Client[]
  ownedContacts     Contact[] @relation("ContactOwner")
  leadStages        LeadStage[]
  notifications     Notification[]
  activities        ContactActivity[]
  tasks             Task[]
  campaignSegments  CampaignSegment[]
  contactNotes      ContactNote[]
  passwordResets    PasswordResetToken[]
}

model SenderAccount {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    SenderProvider
  email       String
  displayName String?
  status      SenderStatus   @default(CONNECTED)
  // Application-level daily cap. The effective cap is MIN(configured cap, provider limit).
  dailyCap    Int            @default(100)

  // --- SMTP (encrypted at rest) ---
  smtpHost             String?
  smtpPort             Int?
  smtpSecure           Boolean  @default(false)
  smtpUsername         String?
  smtpPasswordEnc      String?

  // --- Google OAuth (encrypted at rest; never returned by any API) ---
  googleSubject    String?
  accessTokenEnc   String?
  refreshTokenEnc  String?
  scopes           String[]  @default([])
  tokenExpiresAt   DateTime?

  lastError      String?
  lastUsedAt     DateTime?
  connectedAt    DateTime?
  disconnectedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  dailyUsage  SenderDailyUsage[]
  sendJobs    SendJob[]
  sendAttempts SendAttempt[]
  replies     Reply[]

  @@unique([userId, email])
  @@index([userId, status])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  body        String
  description String?
  // Optional link to a service profile (so one workspace can keep a separate
  // template set per business line).
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  // What the template is for.
  category    TemplateCategory @default(OUTREACH)
  // Incremented on every edit; the previous contents are kept in TemplateVersion.
  version     Int      @default(1)
  // Plain-text alternative (good practice, and required by some providers).
  plainTextBody String?
  // The signature appended to outgoing mail.
  signature   String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]
  versions  TemplateVersion[]

  @@index([userId, serviceId])
  @@index([userId, category])
}

// ---------------------------------------------------------------------------
// Service profiles — one per business line offered by the workspace
// (lead generation, virtual assistance, CRM automation, e-commerce, ...).
// ---------------------------------------------------------------------------

model Service {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  // Free-form: target industries, ideal customer profile, default CTA.
  targetIndustries      String[] @default([])
  idealCustomerProfile  String?
  defaultSubject        String?
  defaultBody           String?
  defaultCta            String?
  // The value the service delivers, in the client's own words.
  valueProposition     String?
  // What a prospect must look like to be a fit (free text).
  qualificationCriteria String?
  color                 String   @default("#6366f1")
  isActive              Boolean  @default(true)
  // Archived services are hidden from pickers but keep their history.
  isArchived            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  campaigns  Campaign[]
  templates  EmailTemplate[]
  sequences  FollowUpSequence[]

  // One service per (workspace, slug).
  @@unique([userId, slug])
  @@index([userId, isActive])
}

model Contact {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email           String
  // Canonical form used for dedupe + suppression checks (lowercased, trimmed).
  emailNormalized String
  firstName       String?
  lastName        String?
  company         String?
  website         String?
  title           String?
  // IANA time zone, e.g. "Asia/Karachi". Null = unknown.
  timeZone        String?
  country         String?
  customFields    Json?
  // Where the lead came from (referral, linkedin, webinar, ...).
  source          String?
  // Free-form notes shown on the contact page.
  notes           String?
  // Labels for segmentation ("saas", "agency", "high-value", ...).
  tags            String[]      @default([])
  // Industry of the contact's company.
  industry        String?
  // Pipeline stage and priority.
  stageId         String?
  stage           LeadStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  priority        LeadPriority  @default(MEDIUM)
  // The operator responsible for this lead (multi-user workspaces).
  ownerId         String?
  owner           User?         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // Set when the prospect becomes a paying client.
  convertedAt     DateTime?
  convertedToClientId String?
  // Archived contacts are excluded from new targeting but keep their history.
  isArchived      Boolean       @default(false)
  status          ContactStatus @default(ACTIVE)
  // Lawful basis / consent tracking.
  consentAt      DateTime?
  consentSource  String?
  lastSentAt     DateTime?
  sentCount      Int            @default(0)
  // Reply tracking (set when a reply is received for this contact).
  lastRepliedAt  DateTime?
  repliedCount   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  campaignRecipients CampaignRecipient[]
  sendJobs           SendJob[]
  unsubscribeEvents  UnsubscribeEvent[]
  followUpMessages   FollowUpMessage[]
  replies            Reply[]
  trackingEvents     TrackingEvent[]
  activities         ContactActivity[]
  tasks              Task[]
  contactNotes       ContactNote[] @relation("contactNotes")

  // One contact per user per normalized email — enforced by the database.
  @@unique([userId, emailNormalized])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, source])
}

model Campaign {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  subject  String
  templateId String?
  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Snapshot of the message body at campaign level (auditable even if the template changes).
  body     String

  // The business line this campaign promotes.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  status          CampaignStatus @default(DRAFT)
  // Emergency stop: worker refuses to send for this campaign until resumed.
  emergencyStopped Boolean       @default(false)
  // Archived campaigns are hidden from the default list but keep all history.
  isArchived      Boolean        @default(false)

  // Manual approval gate: the campaign cannot start until it is approved.
  requiresApproval Boolean  @default(false)
  approvedAt       DateTime?
  approvedBy       String?

  // Dry run: the worker renders the message and marks it delivered WITHOUT
  // contacting the provider. Used to validate configuration before going live.
  dryRun Boolean @default(false)

  // Plain-text alternative of the body.
  plainTextBody String?
  // The signature appended to outgoing mail.
  signature String?
  // Reusable audience filter.
  segmentId String?
  segment   CampaignSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  // When the pre-flight checks last passed.
  preflightCheckedAt DateTime?

  // --- Tracking (opt-in per campaign) -------------------------------------
  // Open tracking adds a 1x1 tracking pixel to the message body.
  trackingEnabled Boolean @default(false)
  // Click tracking rewrites the links in the body to a redirecting tracker.
  clickTrackingEnabled Boolean @default(false)

  // Optional follow-up sequence triggered after the first email is sent.
  followUpSequenceId String?
  followUpSequence   FollowUpSequence? @relation(fields: [followUpSequenceId], references: [id], onDelete: SetNull)

  // Recipient-local sending window (minutes from local midnight). Default 09:00–17:00.
  windowStartMinute Int @default(540)
  windowEndMinute   Int @default(1020)
  // 0=Sunday .. 6=Saturday. Default Mon–Fri.
  sendingDays Int[] @default([1, 2, 3, 4, 5])

  // Recipients with unknown/invalid time zones are HELD unless FALLBACK is configured.
  timeZoneFallback TzFallbackMode @default(HOLD)
  fallbackTimeZone String?

  // Optional campaign-wide daily sending limit (in addition to per-sender caps).
  dailyLimit Int?

  fromName String?
  replyTo  String?

  startAt DateTime?
  endAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients     CampaignRecipient[]
  sendJobs       SendJob[]
  dailyUsage     CampaignDailyUsage[]
  suppressions   Suppression[]
  importBatches  ImportBatch[]
  unsubscribeEvents UnsubscribeEvent[]
  followUpMessages FollowUpMessage[]
  replies          Reply[]
  clientAccess     ClientCampaignAccess[]
  trackingEvents   TrackingEvent[]
  tasks            Task[]

  @@index([userId, status])
  @@index([status])
}

model CampaignRecipient {
  id         String          @id @default(cuid())
  campaignId String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status      RecipientStatus @default(PENDING)
  // UTC instant derived from the recipient's local sending window.
  scheduledAt DateTime?
  sentAt      DateTime?
  failedAt    DateTime?
  skippedAt   DateTime?
  skipReason  String?
  lastError   String?
  importBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sendJob SendJob?

  // *** CRITICAL: a contact can belong to a campaign exactly once. ***
  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([campaignId, scheduledAt])
  @@index([status, scheduledAt])
}

model SendJob {
  id                   String            @id @default(cuid())
  // Nullable: follow-up messages do not belong to a campaign recipient.
  // Still UNIQUE, so there is at most one job per recipient.
  campaignRecipientId  String?           @unique
  campaignRecipient    CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)
  campaignId           String
  campaign             Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId            String
  contact              Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId               String
  // ORIGINAL = the campaign's first message; FOLLOW_UP = a follow-up step.
  kind                 SendJobKind       @default(ORIGINAL)
  // Set for follow-up jobs: the follow-up message this job delivers.
  followUpMessageId    String?           @unique
  followUpMessage      FollowUpMessage?  @relation(fields: [followUpMessageId], references: [id], onDelete: Cascade)
  // Subject/body override the campaign defaults (used by follow-ups).
  subject              String?
  body                 String?

  status     JobStatus     @default(QUEUED)
  // When the job may be claimed (respects recipient-local window; reused for retry backoff).
  scheduledAt DateTime
  claimedAt      DateTime?
  claimedBy      String?
  leaseExpiresAt DateTime?

  attempts   Int @default(0)
  maxAttempts Int @default(5)

  lastError String?
  errorCode String?

  provider         ProviderKind?
  senderAccountId  String?
  senderAccount    SenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  providerMessageId String?

  // Deterministic idempotency key: "job:<campaignRecipientId>".
  // Retried API requests / duplicate enqueues can never create a second job.
  idempotencyKey String @unique
  // Set when a provider call timed out after submission (outcome unknown).
  ambiguousSince DateTime?
  // Set when the provider CONFIRMED delivery (e.g. a webhook). NULL means
  // "not known" — it is never guessed.
  deliveredAt DateTime?
  // Dry run: the message was rendered but never handed to a provider.
  dryRun Boolean @default(false)
  // Set when the job was moved to the dead-letter state (permanently failed
  // and moved out of the queue for manual review).
  deadLetteredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sendAttempts SendAttempt[]

  // Atomic claiming scans this index: due + queued jobs.
  @@index([status, scheduledAt])
  @@index([campaignId, status])
  @@index([userId, status])
}

model SendAttempt {
  id      String      @id @default(cuid())
  jobId   String
  job     SendJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNumber Int
  senderAccountId String?
  senderAccount   SenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)

  status             AttemptStatus
  providerMessageId  String?
  errorCode          String?
  errorMessage       String?
  httpStatus         Int?
  // Value sent as X-EOP-Idempotency-Key / Message-ID hint for reconciliation.
  idempotencyHeader  String?
  latencyMs          Int?
  startedAt          DateTime @default(now())
  finishedAt         DateTime?
  reconciliationNote String?

  // One row per (job, attempt) — prevents double accounting for the same attempt.
  @@unique([jobId, attemptNumber])
  @@index([status, startedAt])
}

model SenderDailyUsage {
  id             String        @id @default(cuid())
  senderAccountId String
  senderAccount  SenderAccount @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)
  // UTC midnight of the quota day (reset timezone configurable via SENDER_QUOTA_TIMEZONE).
  date         DateTime
  sentCount    Int @default(0)
  // Slots reserved by in-flight jobs; released on terminal failure.
  reservedCount Int @default(0)
  failureCount  Int @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([senderAccountId, date])
  @@index([date])
}

model CampaignDailyUsage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date       DateTime
  sentCount  Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, date])
  @@index([date])
}

model Suppression {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope           SuppressionScope  @default(GLOBAL)
  campaignId      String?
  campaign        Campaign?         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailNormalized String
  reason          SuppressionReason
  source          String?
  createdAt       DateTime          @default(now())

  // Partial unique indexes (global / per-campaign) are created in the SQL migration.
  @@index([userId, scope, emailNormalized])
  @@index([campaignId, emailNormalized])
}

model UnsubscribeEvent {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  emailNormalized String
  // SHA-256 of the token that was used (token itself is stateless HMAC, never stored raw).
  tokenHash       String
  reason          String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([emailNormalized, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String // "gmail" | "smtp"
  // Provider event id — unique per provider, guarantees webhook idempotency.
  externalId  String
  eventType   String // BOUNCE | COMPLAINT | DELIVERY | ...
  status      WebhookStatus @default(RECEIVED)
  payload     Json?
  processedAt DateTime?
  errorMessage String?
  createdAt   DateTime      @default(now())

  @@unique([provider, externalId])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "campaign.pause", "sender.disconnect"
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model ImportBatch {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId    String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  filename      String
  status        ImportStatus @default(PENDING)
  totalRows     Int          @default(0)
  importedRows  Int          @default(0)
  // Rows skipped because the (campaign, contact) pair already existed.
  duplicateRows Int          @default(0)
  invalidRows   Int          @default(0)
  error         String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([userId, createdAt])
}

// Fixed-window rate limiting (shared across instances via Postgres).
model RateLimit {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([key, windowStart])
  @@index([windowStart])
}

// Replay protection for mutating API requests that carry an Idempotency-Key header.
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key          String
  endpoint     String
  // Hash of the request body, used to reject key reuse with a different payload.
  requestHash  String?
  responseStatus Int?
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Follow-up sequences
//
// A sequence is a list of steps ("day 3 bump", "day 7 last call"). After the
// first email of a campaign is accepted by the provider, the next step is
// scheduled for each recipient. Every step is cancelled automatically when
// the contact becomes ineligible (replied, unsubscribed, bounced, complained)
// or when the campaign is paused/cancelled.
// ---------------------------------------------------------------------------

model FollowUpSequence {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The business line this sequence belongs to (optional).
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  steps    FollowUpStep[]
  messages FollowUpMessage[]
  campaigns Campaign[]

  @@index([userId, isActive])
}

model FollowUpStep {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  // Position in the sequence (1-based).
  order      Int
  // Days after the previous message was sent.
  delayDays  Int      @default(3)
  subject    String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages FollowUpMessage[]

  // One step per position within a sequence.
  @@unique([sequenceId, order])
}

model FollowUpMessage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sequenceId String
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepId     String
  step       FollowUpStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // The job that delivers this follow-up (the job holds the foreign key).
  job        SendJob?

  scheduledAt   DateTime
  status        FollowUpStatus @default(SCHEDULED)
  sentAt        DateTime?
  failureReason String?
  // Set when the follow-up was cancelled because the contact became ineligible.
  cancelReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([contactId])
  @@index([campaignId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Replies
//
// Received messages are matched to a contact (by the From address) and to a
// campaign (by the most recent message we sent to that contact). A reply
// automatically stops the follow-up sequence for that contact.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// In-app notifications
//
// Created by the worker and the API when something needs the operator's
// attention. Read/unread state and the full history are kept.
// ---------------------------------------------------------------------------

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String?
  // Where to go when the notification is clicked (an in-app path).
  link       String?
  entityType String?
  entityId   String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Contact activity timeline
//
// Every meaningful thing that happened to a contact, in one list.
// ---------------------------------------------------------------------------

model ContactActivity {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      ContactActivityType
  summary   String
  detail    Json?
  createdAt DateTime          @default(now())

  @@index([contactId, createdAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Notes on a contact.
// ---------------------------------------------------------------------------

model ContactNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation("contactNotes", fields: [contactId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
}

// ---------------------------------------------------------------------------
// Tasks / reminders
// ---------------------------------------------------------------------------

model Task {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign  Campaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  status    TaskStatus @default(OPEN)
  dueAt     DateTime?
  completedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Configurable lead pipeline stages
// ---------------------------------------------------------------------------

model LeadStage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  color     String   @default("#6366f1")
  // The stage new contacts start in.
  isDefault Boolean  @default(false)
  // A stage that means "this is a customer".
  isWon     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]

  @@unique([userId, name])
  @@index([userId, order])
}

// ---------------------------------------------------------------------------
// Reusable campaign segments (saved audience filters).
// ---------------------------------------------------------------------------

model CampaignSegment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // The filter, stored as JSON: { status?, source?, tags?, stageId?, priority?, ... }
  filters     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@unique([userId, name])
}

// ---------------------------------------------------------------------------
// Template change history
// ---------------------------------------------------------------------------

model TemplateVersion {
  id            String       @id @default(cuid())
  templateId    String
  template      EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version       Int
  subject       String
  body          String
  plainTextBody String?
  createdAt     DateTime     @default(now())

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

// ---------------------------------------------------------------------------
// Password reset
//
// Only the SHA-256 hash of the token is stored, and it is single-use.
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Reply {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  senderAccountId String?
  senderAccount   SenderAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  // Provider message id — unique per (workspace, provider) for idempotency.
  provider        String
  messageId       String
  fromEmail       String
  toEmail         String
  subject         String?
  snippet         String?
  body            String?
  receivedAt      DateTime
  isRead          Boolean  @default(false)
  // Set when a human classified the reply (INTERESTED, NOT_INTERESTED, ...).
  outcome         String?
  createdAt       DateTime @default(now())

  @@unique([userId, provider, messageId])
  @@index([userId, receivedAt])
  @@index([userId, isRead])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Client portal
//
// A client is a separate login that can only see the campaigns an
// administrator explicitly assigned to it. The client's own password hash is
// stored here; it never shares the workspace owner's credentials.
// ---------------------------------------------------------------------------

model Client {
  id           String   @id @default(cuid())
  // The workspace that owns this client account.
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Login identity. Globally unique so a client sign-in is unambiguous.
  email        String   @unique
  passwordHash String
  name         String
  company      String?
  isActive     Boolean  @default(true)
  // Bumping this invalidates every outstanding client session.
  sessionVersion Int    @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaignAccess ClientCampaignAccess[]

  @@index([userId, isActive])
}

// Which campaigns a client may see. Explicit, never inferred.
model ClientCampaignAccess {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  // A campaign is assigned to a client at most once.
  @@unique([clientId, campaignId])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Tracking
//
// Open and click events. `dedupeKey` is set only on the FIRST event of its
// kind (open per recipient, click per recipient+link), so unique counts are a
// simple indexed count and repeated events are still recorded for the total.
// ---------------------------------------------------------------------------

model TrackingEvent {
  id         String            @id @default(cuid())
  campaignId String
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type       TrackingEventType
  source     TrackingSource    @default(HUMAN)
  // The original (untracked) URL for CLICK events.
  url        String?
  userAgent  String?
  ipAddress  String?
  // Set on the first event of its kind; NULL for repeats. NULLs are allowed
  // many times in a Postgres unique index, so repeats are never rejected.
  dedupeKey  String?           @unique
  createdAt  DateTime          @default(now())

  @@index([campaignId, type])
  @@index([campaignId, contactId, type])
  @@index([campaignId, createdAt])
  @@index([contactId])
}
